---
const API_KEY = import.meta.env.GOOGLE_SHEETS_API_KEY;
const SHEET_ID = import.meta.env.SPREADSHEET_ID;

const RANGE = "A2:C"; 

const url = `https://sheets.googleapis.com/v4/spreadsheets/${SHEET_ID}/values/${RANGE}?key=${API_KEY}`;

interface Evento {
  letrasDia: string;
  fechaNum: string;
  ciudad: string;
  local: string;
}

let eventos: Evento[] = [];

try {
  if (!API_KEY || !SHEET_ID) throw new Error("Faltan GOOGLE_SHEETS_API_KEY o SPREADSHEET_ID");

  const response = await fetch(url);
  if (!response.ok) throw new Error(`Google Sheets respondió ${response.status}`);
  const data = await response.json();

  if (Array.isArray(data.values)) {
    eventos = data.values
      // ignorar filas vacías o sin fecha (antes una fila vacía rompía todo el listado)
      .filter((fila: string[]) => fila?.[0]?.trim())
      .map((fila: string[]) => {
        const [letrasDia = "", fechaNum = ""] = fila[0].trim().split(/\s+/); // "SAB 18/04"
        return {
          letrasDia,
          fechaNum,
          local: fila[1]?.trim() || "",
          ciudad: fila[2]?.trim() || "",
        };
      });
  }
} catch (error) {
  console.error("Hubo un error de red al coger las fechas:", error);
}
---
<section id="fechas" class="w-full relative py-24 px-8 md:px-16 overflow-hidden bg-black">
  <div class="max-w-5xl mx-auto flex flex-col gap-12">
    
<div class="relative w-full text-center font-hanson text-[12vw] md:text-[8vw] uppercase leading-none select-none">
      
      <div class="text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.2);">
        FECHAS
      </div>
      
      <div class="texto-relleno absolute top-0 left-0 w-full h-full text-white text-center">
        FECHAS
      </div>

    </div>

    <div class="contenedor-fechas flex flex-col mt-4 md:mt-8">
      {eventos.length === 0 && (
        <p class="text-white/50 text-xs md:text-base uppercase tracking-widest text-center py-6 border-b border-white/20">
          Próximas fechas muy pronto
        </p>
      )}
      {eventos.map((evento) => (
        <div data-fecha={evento.fechaNum} class="fila-fecha group grid grid-cols-[0.5fr_1fr_1fr] items-center py-3 border-b border-white/20 transition-colors hover:border-white/50 md:py-6">
          <span class="font-hanson text-white/70 uppercase text-[9px] sm:text-xs md:text-xl text-left tracking-wider">
            {evento.letrasDia} <br/> {evento.fechaNum}
          </span>
          
          <span class="text-white text-[8px] sm:text-xs md:text-base uppercase tracking-wider text-center">
            {evento.local}
          </span>

          <span class="text-white/70 text-[8px] sm:text-xs md:text-lg uppercase tracking-wider text-right">
            {evento.ciudad}
          </span>
          
        </div>
      ))}
    </div>

  </div>
</section>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Apaga las fechas que ya han pasado. Se calcula en el navegador al abrir la página
  // (no al publicarla), así que siempre compara con el día real de la visita.
  // La hoja no lleva año ("SAB 18/04"), así que se deduce suponiendo que las fechas
  // están en orden: si una fecha es anterior a la de la fila de arriba, ha cambiado el año.
  function marcarFechasPasadas() {
    const filas = document.querySelectorAll<HTMLElement>(".fila-fecha[data-fecha]");
    const hoy = new Date();
    hoy.setHours(0, 0, 0, 0);
    const mesHoy = hoy.getMonth() + 1;

    let anio = hoy.getFullYear();
    let anterior: Date | null = null;

    filas.forEach((fila) => {
      const [dia, mes, anioEscrito] = (fila.dataset.fecha ?? "").split(/[\/\-.]/).map(Number);
      if (!dia || !mes) return;

      if (anioEscrito) {
        // si algún día se escribe el año en la hoja (18/04/2027), se usa tal cual
        anio = anioEscrito < 100 ? 2000 + anioEscrito : anioEscrito;
      } else if (anterior === null) {
        // primera fila: decidir a qué año pertenece respecto a hoy
        if (mes - mesHoy > 6) anio--;      // p. ej. vemos la web en enero y la lista empieza en diciembre
        else if (mesHoy - mes > 6) anio++; // p. ej. vemos la web en diciembre y la lista empieza en enero
      }

      let fecha = new Date(anio, mes - 1, dia);
      if (!anioEscrito && anterior && fecha < anterior) {
        anio++; // cambio de año dentro de la lista (dic -> ene)
        fecha = new Date(anio, mes - 1, dia);
      }
      anterior = fecha;

      // el mismo día del bolo sigue contando como próxima fecha
      if (fecha < hoy) fila.classList.add("fecha-pasada");
    });
  }

  document.addEventListener("DOMContentLoaded", () => {

    marcarFechasPasadas();
    
    //animación titulo fechas
    gsap.fromTo(".texto-relleno", 
      {
        
        clipPath: "polygon(0% 50%, 100% 50%, 100% 50%, 0% 50%)"
      },
      {
        
        clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
        ease: "none", 
        scrollTrigger: {
          trigger: "#fechas", 
          start: "top 65%",   
          end: "top 15%",   
          scrub: 1.5,
          markers: false        
        }
      }
    );
    
    if (!document.querySelector(".fila-fecha")) return;

    const fechasTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".contenedor-fechas",
        start: "top 85%",    
        end: "bottom 85%",   
        scrub: 0.8,          
        markers: false        
      }
    });

    fechasTl.from(".fila-fecha", {
      y: 40,               
      opacity: 0,          
      ease: "power2.out",  
      stagger: 0.5         
    });

  });
</script>

<style>
  /* Fechas ya pasadas: apagadas para que la vista vaya a las próximas */
  .fecha-pasada > span {
    opacity: 0.3;
  }
  .fecha-pasada {
    border-color: rgba(255, 255, 255, 0.08);
  }
</style>